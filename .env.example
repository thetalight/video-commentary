# Backend only. Never use VITE_ for API credentials.
# Copy to .env and fill in your key. Process environment takes precedence.
DEEPSEEK_API_KEY=
# HTTPS API base URL, optionally ending in /v1; NOT /chat/completions.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Sent exactly as configured; your endpoint must support this model ID.
DEEPSEEK_MODEL=deepseek-flash

# Optional: short-keyword web research during automatic review/repair (max 3 searches).
# Leave blank to review and repair using subtitles only. Never use VITE_ prefix.
TAVILY_API_KEY=
